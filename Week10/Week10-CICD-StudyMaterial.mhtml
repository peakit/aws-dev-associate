<h2 data-sourcepos=3D"31:1-32:3" dir=3D"auto">
<a href=3D"https://git.epam.com/epmc-acm-public/aws-associate-training/-/bl=
ob/master/materials/ci_cd/README.md#" aria-hidden=3D"true" class=3D"anchor"=
 id=3D"user-content-"></a><a class=3D"no-attachment-icon gfm" href=3D"https=
